@page
@model WebAppMTG.Pages.DeckContentsModel
@using System.Globalization
@{
    ViewData["Title"] = "Deck inhoud";
}
@functions {
    public string GetCardTypeGroup(string? typeLine)
    {
        if (string.IsNullOrWhiteSpace(typeLine))
            return "Overig";
        var lower = typeLine.ToLower();
        if (lower.Contains("creature")) return "Creatures";
        if (lower.Contains("instant")) return "Instants";
        if (lower.Contains("sorcery")) return "Sorceries";
        if (lower.Contains("artifact")) return "Artifacts";
        if (lower.Contains("enchantment")) return "Enchantments";
        if (lower.Contains("planeswalker")) return "Planeswalkers";
        if (lower.Contains("land")) return "Lands";
        if (lower.Contains("battle")) return "Battles";
        return "Overig";
    }

    public int GetTypeOrder(string? typeLine)
    {
        var group = GetCardTypeGroup(typeLine);
        return group switch
        {
            "Creatures" => 1,
            "Instants" => 2,
            "Sorceries" => 3,
            "Artifacts" => 4,
            "Enchantments" => 5,
            "Planeswalkers" => 6,
            "Lands" => 7,
            "Battles" => 8,
            _ => 9
        };
    }

    public string ToSafeId(string value)
    {
        return value.ToLower().Replace(" ", "-");
    }
}

<section class="deck-contents-page">
    <div class="deck-contents-container">
        <div class="detail-topbar">
            <a asp-page="/DecksOverview" class="back-link-top">
                ← Terug naar decks
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="custom-alert custom-alert-danger">@Model.ErrorMessage</div>
        }
        else if (Model.Deck == null)
        {
            <div class="empty-state">
                <p>Deck niet gevonden.</p>
            </div>
        }
        else
        {
            <div class="deck-hero">
                <div class="deck-hero-main">
                    <div class="deck-title-row">
                        <form method="post" asp-page-handler="DeleteDeck" id="deleteDeckForm">
                            <input type="hidden" name="itemId" value="@Model.Deck.ItemId" />
                        </form>

                        <form method="post" asp-page-handler="RenameDeck" id="renameDeckForm" class="deck-title-form">
                            <input type="hidden" name="itemId" value="@Model.Deck.ItemId" />

                            <button type="button"
                                    class="icon-action-button danger-button"
                                    title="Deck verwijderen"
                                    onclick="confirmDeleteDeck()">
                                🗑
                            </button>

                            <button type="button"
                                    id="editDeckNameButton"
                                    class="icon-action-button"
                                    onclick="enableDeckNameEdit()"
                                    title="Decknaam aanpassen">
                                ✏️
                            </button>

                            <button type="submit"
                                    id="confirmDeckNameButton"
                                    class="icon-action-button confirm-button"
                                    title="Bevestigen"
                                    style="display:none;">
                                ✔
                            </button>

                            <span id="deckNameText" class="deck-title-text">@Model.Deck.Name</span>
                            <input type="text"
                                   id="deckNameInput"
                                   name="NewDeckName"
                                   value="@Model.Deck.Name"
                                   class="form-control custom-input deck-name-input-inline"
                                   style="display:none;"
                                   required />
                        </form>

                        
                    </div>

                    <p>@(string.IsNullOrWhiteSpace(Model.Deck.Description) ? "Geen beschrijving opgegeven." : Model.Deck.Description)</p>
                </div>

                <div class="deck-hero-meta">
                    <div class="deck-meta-card">
                        <span class="deck-meta-label">Format</span>
                        <span class="deck-meta-value">@Model.Deck.Format</span>
                    </div>
                    <div class="deck-meta-card">
                        <span class="deck-meta-label">Mainboard</span>
                        <span class="deck-meta-value">@Model.Deck.Mainboard.Sum(c => c.Quantity)</span>
                    </div>
                    <div class="deck-meta-card">
                        <span class="deck-meta-label">Sideboard</span>
                        <span class="deck-meta-value">@Model.Deck.Sideboard.Sum(c => c.Quantity)</span>
                    </div>
                </div>
            </div>

            @if (Model.LegalityResult != null)
            {
                @if (Model.LegalityResult.IsLegal)
                {
                    <div class="custom-alert deck-alert-success">
                        Dit deck is legaal.
                    </div>
                }
                else
                {
                    <div class="custom-alert deck-alert-warning">
                        <strong>Dit deck is niet legaal.</strong>
                        <ul class="deck-error-list">
                            @foreach (var error in Model.LegalityResult.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
            }

            <div class="deck-section">
                <div class="deck-section-header">
                    <h2>Mainboard</h2>
                </div>
                @if (Model.Deck.Mainboard.Count == 0)
                {
                    <div class="empty-state">
                        <p>Geen kaarten in mainboard.</p>
                    </div>
                }
                else
                {
                    var groupedMainboard = Model.Deck.Mainboard
                        .OrderBy(c => GetTypeOrder(c.Card.TypeLine))
                        .ThenBy(c => c.Card.Name)
                        .GroupBy(c => GetCardTypeGroup(c.Card.TypeLine));

                    <div class="deck-type-columns">
                        @foreach (var group in groupedMainboard)
                        {
                            <div class="deck-type-group">
                                <div class="deck-type-group-header">
                                    <h3>@group.Key</h3>
                                    <span>@group.Sum(x => x.Quantity) kaarten</span>
                                </div>
                                <div class="deck-type-card-list">
                                    @foreach (var card in group)
                                    {
                                        var cardElementId = $"main-{ToSafeId(group.Key)}-{card.Card.Id}";
                                        <div class="deck-card-entry-big compact-card" id="@cardElementId">
                                            <div class="deck-card-entry-top">
                                                <div class="deck-card-entry-info">
                                                    <h4>@card.Card.Name</h4>
                                                    <p class="deck-card-entry-type">@card.Card.TypeLine</p>
                                                </div>
                                                <div class="card-inline-controls">
                                                    <span class="deck-quantity-badge">x @card.Quantity</span>
                                                    <button type="button"
                                                            class="card-size-toggle-button"
                                                            onclick="toggleCardSize('@cardElementId', this)">
                                                        Groot tonen
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="deck-card-entry-visual">
                                                @if (!string.IsNullOrWhiteSpace(card.Card.ImageUrl))
                                                {
                                                    <img src="@card.Card.ImageUrl" alt="@card.Card.Name" class="deck-card-large-image" />
                                                }
                                                else
                                                {
                                                    <div class="deck-card-large-image no-deck-card-image">
                                                        <span>Geen afbeelding</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="deck-card-entry-footer">
                                                <form method="post" asp-page-handler="RemoveCard">
                                                    <input type="hidden" name="itemId" value="@Model.Deck.ItemId" />
                                                    <input type="hidden" name="cardEntryId" value="@card.Card.Id" />
                                                    <button type="submit" class="danger-action-button">Verwijderen</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="deck-section">
                <div class="deck-section-header">
                    <h2>Sideboard</h2>
                </div>
                @if (Model.Deck.Sideboard.Count == 0)
                {
                    <div class="empty-state">
                        <p>Geen kaarten in sideboard.</p>
                    </div>
                }
                else
                {
                    var groupedSideboard = Model.Deck.Sideboard
                        .OrderBy(c => GetTypeOrder(c.Card.TypeLine))
                        .ThenBy(c => c.Card.Name)
                        .GroupBy(c => GetCardTypeGroup(c.Card.TypeLine));

                    <div class="deck-type-columns">
                        @foreach (var group in groupedSideboard)
                        {
                            <div class="deck-type-group">
                                <div class="deck-type-group-header">
                                    <h3>@group.Key</h3>
                                    <span>@group.Sum(x => x.Quantity) kaarten</span>
                                </div>
                                <div class="deck-type-card-list">
                                    @foreach (var card in group)
                                    {
                                        var cardElementId = $"side-{ToSafeId(group.Key)}-{card.Card.Id}";
                                        <div class="deck-card-entry-big compact-card" id="@cardElementId">
                                            <div class="deck-card-entry-top">
                                                <div class="deck-card-entry-info">
                                                    <h4>@card.Card.Name</h4>
                                                    <p class="deck-card-entry-type">@card.Card.TypeLine</p>
                                                </div>
                                                <div class="card-inline-controls">
                                                    <span class="deck-quantity-badge">x @card.Quantity</span>
                                                    <button type="button"
                                                            class="card-size-toggle-button"
                                                            onclick="toggleCardSize('@cardElementId', this)">
                                                        Groot tonen
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="deck-card-entry-visual">
                                                @if (!string.IsNullOrWhiteSpace(card.Card.ImageUrl))
                                                {
                                                    <img src="@card.Card.ImageUrl" alt="@card.Card.Name" class="deck-card-large-image" />
                                                }
                                                else
                                                {
                                                    <div class="deck-card-large-image no-deck-card-image">
                                                        <span>Geen afbeelding</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="deck-card-entry-footer">
                                                <form method="post" asp-page-handler="RemoveCard">
                                                    <input type="hidden" name="itemId" value="@Model.Deck.ItemId" />
                                                    <input type="hidden" name="cardEntryId" value="@card.Card.Id" />
                                                    <button type="submit" class="danger-action-button">Verwijderen</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function toggleCardSize(cardId, button) {
            const card = document.getElementById(cardId);
            if (!card) return;

            const isCompact = card.classList.contains("compact-card");
            card.classList.remove("compact-card", "large-card");

            if (isCompact) {
                card.classList.add("large-card");
                button.textContent = "Klein tonen";
            } else {
                card.classList.add("compact-card");
                button.textContent = "Groot tonen";
            }
        }

        function enableDeckNameEdit() {
            const text = document.getElementById("deckNameText");
            const input = document.getElementById("deckNameInput");
            const editButton = document.getElementById("editDeckNameButton");
            const confirmButton = document.getElementById("confirmDeckNameButton");

            text.style.display = "none";
            input.style.display = "inline-block";
            editButton.style.display = "none";
            confirmButton.style.display = "inline-block";

            input.focus();
            input.select();
        }

        function confirmDeleteDeck() {
            const confirmed = confirm("Weet je zeker dat je dit deck wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt.");
            if (confirmed) {
                document.getElementById("deleteDeckForm").submit();
            }
        }
    </script>
}