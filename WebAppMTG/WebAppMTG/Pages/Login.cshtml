@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1>Login</h1>
                <p>Log in om je decks te bekijken en beheren.</p>
            </div>

            <div asp-validation-summary="ModelOnly"></div>

            <form method="post" class="auth-form">
                <div class="form-group-custom">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="custom-input" placeholder="jij@email.com" />
                    <span asp-validation-for="Input.Email"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="custom-input" placeholder="Wachtwoord" />
                    <span asp-validation-for="Input.Password"></span>
                </div>

                <div class="auth-actions">
                    <button type="submit" class="primary-action-button">Inloggen</button>
                </div>
            </form>

            <div class="auth-footer-text">
                Nog geen account?
                <a asp-page="/Register">Registreer hier</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}