@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <h1>Maak een account</h1>
                <p>Registreer je om decks op te slaan en te beheren.</p>
            </div>

            <div asp-validation-summary="ModelOnly"></div>

            <form method="post" class="auth-form">
                <div class="form-group-custom">
                    <label asp-for="Input.Name"></label>
                    <input asp-for="Input.Name" class="custom-input" placeholder="Jouw naam" />
                    <span asp-validation-for="Input.Name"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="custom-input" placeholder="jij@email.com" />
                    <span asp-validation-for="Input.Email"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="custom-input" placeholder="Minstens 6 karakters" />
                    <span asp-validation-for="Input.Password"></span>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="custom-input" placeholder="Herhaal wachtwoord" />
                    <span asp-validation-for="Input.ConfirmPassword"></span>
                </div>

                <div class="auth-actions">
                    <button type="submit" class="primary-action-button">Registreren</button>
                </div>
            </form>

            <div class="auth-footer-text">
                Heb je al een account?
                <a asp-page="/Login">Log hier in</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
