@page
@model WebAppMTG.Pages.CardOverviewModel
@{
    ViewData["Title"] = "Card Overview";
}

<section class="card-overview-page">
    <div class="card-overview-container">

        @if (!string.IsNullOrEmpty(Model.ApiErrorMessage))
        {
            <div class="custom-alert custom-alert-danger">@Model.ApiErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.DeckErrorMessage))
        {
            <div class="custom-alert custom-alert-warning">@Model.DeckErrorMessage</div>
        }

        @if (Model.Cards == null || Model.Cards.Count == 0)
        {
            <div class="empty-state">
                <p>Geen kaarten gevonden.</p>
            </div>
        }
        else
        {
            <div class="card-grid">
                @foreach (var card in Model.Cards)
                {
                    var modalId = $"addToDeckModal_{card.Id}";

                    <div class="card-item">
                        <a asp-page="/DetailedCardOverview"
                           asp-route-id="@card.Id"
                           class="card-link">
                            <div class="card-box">
                                @if (!string.IsNullOrEmpty(card.ImageUrl))
                                {
                                    <img src="@card.ImageUrl" alt="@card.Name" class="card-image" />
                                }
                                else
                                {
                                    <div class="card-image no-image-placeholder">
                                        <span>Geen afbeelding</span>
                                    </div>
                                }

                                <div class="card-name">@card.Name</div>
                            </div>
                        </a>

                        @if (Model.CanAddToDeck)
                        {
                            <button type="button"
                                    class="add-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@modalId">
                                Voeg toe aan deck
                            </button>
                        }
                    </div>

                    @if (Model.CanAddToDeck)
                    {
                        <div class="modal fade custom-modal" id="@modalId" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content custom-modal-content">
                                    <form method="post" asp-page-handler="AddToDeck">
                                        @Html.AntiForgeryToken()

                                        <div class="modal-header custom-modal-header">
                                            <h5 class="modal-title">Voeg @card.Name toe aan een deck</h5>
                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Sluiten"></button>
                                        </div>

                                        <div class="modal-body custom-modal-body">
                                            <input type="hidden" asp-for="SelectedCardId" value="@card.Id" />

                                            <input type="hidden" asp-for="Query" />
                                            <input type="hidden" asp-for="Name" />
                                            <input type="hidden" asp-for="TypeLine" />
                                            <input type="hidden" asp-for="Color" />
                                            <input type="hidden" asp-for="ManaValue" />
                                            <input type="hidden" asp-for="Format" />

                                            <div class="mb-3">
                                                <label asp-for="SelectedDeckId" class="form-label">Deck</label>
                                                <select asp-for="SelectedDeckId" class="form-select custom-input" required>
                                                    <option value="">-- Kies een deck --</option>
                                                    @foreach (var deck in Model.UserDecks)
                                                    {
                                                        <option value="@deck.ItemId">@deck.Name (@deck.Format)</option>
                                                    }
                                                </select>
                                            </div>

                                            <div class="mb-3">
                                                <label asp-for="QuantityToAdd" class="form-label">Aantal</label>
                                                <input asp-for="QuantityToAdd"
                                                       type="number"
                                                       min="1"
                                                       class="form-control custom-input" />
                                            </div>

                                            <div class="mb-3">
                                                <label asp-for="SelectedBoardPart" class="form-label">Board part</label>
                                                <select asp-for="SelectedBoardPart" class="form-select custom-input">
                                                    <option value="Mainboard">Mainboard</option>
                                                    <option value="Sideboard">Sideboard</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="modal-footer custom-modal-footer">
                                            <button type="button"
                                                    class="secondary-action-button"
                                                    data-bs-dismiss="modal">
                                                Annuleren
                                            </button>
                                            <button type="submit" class="primary-action-button">
                                                Toevoegen
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>