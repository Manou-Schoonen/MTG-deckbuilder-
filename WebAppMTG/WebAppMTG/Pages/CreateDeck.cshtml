@page
@model WebAppMTG.Pages.CreateDeckModel
@{
    ViewData["Title"] = "Nieuw deck aanmaken";
}

<section class="create-deck-page">
    <div class="create-deck-shell">
        <div class="create-deck-container centered-create-deck">
            <div class="create-deck-header centered-header">
                <h1>Nieuw deck aanmaken</h1>
                <p>Maak een nieuw deck aan en kies het format.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="custom-alert custom-alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" class="create-deck-form">
                <div class="form-group-custom">
                    <label asp-for="Name">Naam</label>
                    <input asp-for="Name" class="custom-input" />
                </div>

                <div class="form-group-custom">
                    <label asp-for="Format">Format</label>
                    <select asp-for="Format" class="custom-input">
                        <option value="standard">Standard</option>
                        <option value="pioneer">Pioneer</option>
                        <option value="modern">Modern</option>
                        <option value="legacy">Legacy</option>
                        <option value="vintage">Vintage</option>
                        <option value="commander">Commander</option>
                        <option value="pauper">Pauper</option>
                        <option value="historic">Historic</option>
                        <option value="brawl">Brawl</option>
                        <option value="alchemy">Alchemy</option>
                        <option value="timeless">Timeless</option>
                        <option value="oathbreaker">Oathbreaker</option>
                        <option value="penny">Penny</option>
                    </select>
                </div>

                <div class="form-group-custom">
                    <label asp-for="Description">Beschrijving</label>
                    <textarea asp-for="Description" class="custom-input custom-textarea"></textarea>
                </div>

                <div class="create-deck-actions centered-actions">
                    <a asp-page="/DecksOverview" class="secondary-action-button">Annuleren</a>
                    <button type="submit" class="primary-action-button">Deck aanmaken</button>
                </div>
            </form>
        </div>
    </div>
</section>